<Window
    x:Class="LumaDim.QuickControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LumaDim Quick Control">
    <Border x:ConnectionId='2'
        x:Name="Root"
        Padding="14,10,14,12"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="8"
                                            
                                          >
        <StackPanel Spacing="6" VerticalAlignment="Center">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource AppBodyStrongTextStyle}"
                    Text="Brightness" />
                <TextBlock x:ConnectionId='4'
                    x:Name="ValueText"
                    Grid.Column="1"
                    MinWidth="44"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="65%" />
                <Button x:ConnectionId='5'
                    x:Name="DimOffButton"
                    Grid.Column="2"
                    Height="30"
                    Padding="11,0"
                    VerticalAlignment="Center"
                                              
                    Content="Dim off" />
                <Button x:ConnectionId='6'
                    x:Name="SettingsButton"
                    Grid.Column="3"
                    Height="30"
                    Padding="9,0"
                    VerticalAlignment="Center"
                                                >
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </Grid>
            <Slider x:ConnectionId='3'
                x:Name="LevelSlider"
                Margin="0,2,0,0"
                LargeChange="5"
                Maximum="100"
                Minimum="45"
                SmallChange="1"
                StepFrequency="1"
                Value="65" />
        </StackPanel>
    </Border>
</Window>

