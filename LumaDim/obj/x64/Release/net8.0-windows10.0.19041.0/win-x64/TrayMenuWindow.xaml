<Window
    x:Class="LumaDim.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LumaDim Menu">
    <Border x:ConnectionId='2'
        x:Name="Root"
        Padding="6"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Opacity="0"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="1">
            <Border x:ConnectionId='3'
                x:Name="OpenRow"
                Style="{ThemeResource MenuRowStyle}"
                                                   
                                                 
                                       >
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE713;"
                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Open LumaDim" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:ConnectionId='4'
                x:Name="DimOffRow"
                Style="{ThemeResource MenuRowStyle}"
                                                   
                                                 
                                         >
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE706;"
                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Turn off dimming" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Rectangle
                Style="{ThemeResource DividerStyle}"
                Margin="6,4" />

            <Border x:ConnectionId='5'
                x:Name="StartupRow"
                Style="{ThemeResource MenuRowStyle}"
                                                   
                                                 
                                          >
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Start with Windows" VerticalAlignment="Center" />
                    <FontIcon x:ConnectionId='9'
                        x:Name="StartupCheck"
                        Grid.Column="2"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Glyph="&#xE73E;"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:ConnectionId='6'
                x:Name="IndicatorRow"
                Style="{ThemeResource MenuRowStyle}"
                                                   
                                                 
                                            >
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="On-screen indicator" VerticalAlignment="Center" />
                    <FontIcon x:ConnectionId='8'
                        x:Name="IndicatorCheck"
                        Grid.Column="2"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Glyph="&#xE73E;"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Rectangle
                Style="{ThemeResource DividerStyle}"
                Margin="6,4" />

            <Border x:ConnectionId='7'
                x:Name="ExitRow"
                Style="{ThemeResource MenuRowStyle}"
                                                   
                                                 
                                       >
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7E8;"
                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Exit" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>

