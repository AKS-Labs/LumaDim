<Window
    x:Class="LumaDim.BrightnessOsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LumaDim Indicator">
    <Border
        x:Name="Root"
        Padding="18,0,14,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Opacity="0"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid ColumnSpacing="12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE706;" FontSize="17" VerticalAlignment="Center" />
            <Grid x:Name="Track" Grid.Column="1" Width="140" Height="4" VerticalAlignment="Center">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="2" />
                <Border
                    x:Name="Fill"
                    Width="91"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource TextFillColorPrimaryBrush}"
                    CornerRadius="2" />
            </Grid>
            <TextBlock
                x:Name="ValueText"
                Grid.Column="2"
                MinWidth="44"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Text="65%" />
        </Grid>
    </Border>
</Window>
